{
  "name": "runplane-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:embed": "pnpm build && node scripts/embed.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:api": "go run ../cmd/runplane openapi > src/api/openapi.json && openapi-typescript src/api/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "~1.169.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.66.0",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
